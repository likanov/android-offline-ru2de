{
  "name": "german-vocabulary",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "node --experimental-sqlite node_modules/jest/bin/jest.js",
    "test:sql": "node --experimental-sqlite node_modules/jest/bin/jest.js --selectProjects sql --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prebuild:android": "expo prebuild --platform android --template expo-template-bare-minimum@56.0.37"
  },
  "dependencies": {
    "expo": "56.0.23",
    "expo-crypto": "~56.0.2",
    "expo-sqlite": "56.0.6",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.2"
  }
}
